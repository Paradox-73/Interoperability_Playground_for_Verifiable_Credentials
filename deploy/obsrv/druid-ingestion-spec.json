{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "inji-playground-runs",
      "timestampSpec": { "column": "ets", "format": "millis" },
      "dimensionsSpec": {
        "dimensions": [
          "eid",
          "runId",
          "mode",
          "issuer",
          "wallet",
          "verifier",
          "format",
          "scenario",
          "expected",
          "outcome",
          "verdict",
          "errorCode",
          "step",
          "stepStatus"
        ]
      },
      "metricsSpec": [
        { "name": "count", "type": "count" },
        { "name": "success_sum", "fieldName": "success", "type": "longSum" },
        { "name": "durationMs_sum", "fieldName": "durationMs", "type": "doubleSum" },
        { "name": "durationMs_min", "fieldName": "durationMs", "type": "doubleMin" },
        { "name": "durationMs_max", "fieldName": "durationMs", "type": "doubleMax" }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "MINUTE",
        "rollup": true
      }
    },
    "ioConfig": {
      "topic": "inji-playground-runs",
      "inputFormat": { "type": "json" },
      "consumerProperties": { "bootstrap.servers": "localhost:9092" },
      "useEarliestOffset": true,
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H"
    },
    "tuningConfig": { "type": "kafka", "maxRowsPerSegment": 5000000 }
  }
}
