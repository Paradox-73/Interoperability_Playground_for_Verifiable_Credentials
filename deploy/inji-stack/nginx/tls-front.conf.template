# SPDX-License-Identifier: MIT
#
# TLS front of the ps02-inji stack (written for the PS02 playground; not an upstream file).
#
# Inji's verifier library resolves did:web only over https (gap G2), so a locally hosted issuer DID such as
# did:web:certify.ps02.test needs a real TLS endpoint inside the compose network. This nginx carries the
# network aliases certify.ps02.test, verify.ps02.test and ref.ps02.test (.test is a reserved top-level domain)
# and serves them on port 443 with a certificate from the stack's test CA (scripts/stack-init.sh). Java services
# trust that CA through the Temurin entrypoint (USE_SYSTEM_CA_CERTS=1); Node clients through NODE_EXTRA_CA_CERTS.
#
# The nginx image renders this template with envsubst at start; only ${REF_UPSTREAM} is substituted.
# Upstream names are resolved per request (resolver + variables), so this front starts even when an upstream,
# such as the playground on the host, is not running yet.

resolver 127.0.0.11 valid=10s ipv6=off;

ssl_certificate     /etc/nginx/tls/server.crt;
ssl_certificate_key /etc/nginx/tls/server.key;
ssl_protocols       TLSv1.2 TLSv1.3;

proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_read_timeout 120s;

# Unknown host names get no answer rather than another site's content.
server {
    listen 443 ssl default_server;
    server_name _;
    return 421;
}

# Inji Certify: https://certify.ps02.test/.well-known/did.json is the did:web document of
# did:web:certify.ps02.test; everything else goes through certify-nginx, as plain-HTTP clients see it.
server {
    listen 443 ssl;
    server_name certify.ps02.test;

    location / {
        set $certify_nginx http://certify-nginx:80;
        proxy_pass $certify_nginx;
        proxy_set_header Host certify-nginx;
    }
}

# certify-ac (holder-web profile): https://certify-ac.ps02.test/.well-known/did.json is the did:web document of
# did:web:certify-ac.ps02.test. Everything else of certify-ac goes through the playground proxy.
server {
    listen 443 ssl;
    server_name certify-ac.ps02.test;

    location = /.well-known/did.json {
        set $certify_ac http://certify-ac:8090;
        proxy_pass $certify_ac/v1/certify/.well-known/did.json;
        proxy_set_header Host $host;
    }
    location / {
        return 404;
    }
}

# Inji Verify: did:web:verify.ps02.test:v1:verify resolves to https://verify.ps02.test/v1/verify/did.json.
server {
    listen 443 ssl;
    server_name verify.ps02.test;

    location / {
        set $verify_service http://verify-service:8080;
        proxy_pass $verify_service;
        proxy_set_header Host $host;
    }
}

# Playground server: DID documents and endpoints of the reference roles. REF_UPSTREAM is the playground
# container in the bundle, or the host (host.docker.internal) when the playground runs outside Docker.
server {
    listen 443 ssl;
    # playground.ps02.test serves the JSON-LD context of the reference credentials (formats package).
    server_name ref.ps02.test playground.ps02.test;

    location / {
        set $playground ${REF_UPSTREAM};
        proxy_pass $playground;
        proxy_set_header Host $host;
    }
}

# JSON-LD context hosts (network aliases www.w3.org, w3id.org, piyush7034.github.io): the Inji services load the
# contexts of every ldp_vc and ldp_vp from them. w3id.org redirects to GitHub Pages, which also hosts the
# Certify farmer sample's context, and GitHub Pages answers HTTP 429 after a few dozen runs (measured
# 2026-10-06: 5 of 20 live tests failed with LOADING_REMOTE_CONTEXT_FAILED). This front fetches each document
# once from the real host through public DNS, follows a redirect itself, answers from its cache afterwards, and
# keeps answering with the stale copy when the host fails or rate-limits. The documents are not changed.
proxy_cache_path /var/cache/nginx/contexts levels=1:2 keys_zone=contexts:10m max_size=64m inactive=365d use_temp_path=off;

server {
    listen 443 ssl;
    server_name www.w3.org w3id.org piyush7034.github.io;
    # Not the Docker resolver: inside the network these names are this front itself.
    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

    proxy_ssl_server_name on;
    proxy_cache contexts;
    proxy_cache_valid 200 365d;
    proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
    proxy_cache_lock on;
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
    proxy_intercept_errors on;
    # Uncompressed from the host: the cache ignores Vary, and Java clients ask for no encoding.
    proxy_set_header Accept-Encoding "";

    location / {
        proxy_pass https://$host$request_uri;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding "";
        proxy_cache_key $host$request_uri;
        # Redirects are not cached: on a cache hit nginx has no upstream Location header to follow.
        error_page 301 302 303 307 308 = @redirected;
        add_header X-Ps02-Context-Cache $upstream_cache_status always;
    }

    # One redirect followed here (w3id.org -> *.github.io), so the service gets the document itself.
    # The document is cached under the key of the original request: the next request is then a hit in
    # location / and never reaches w3id.org. Keyed by the redirect target instead, every w3id.org context
    # went to w3id.org for the redirect (2 to 4 s, timeouts on 2026-10-19) and failed ldp_vc verifications.
    location @redirected {
        set $target $upstream_http_location;
        proxy_pass $target;
        proxy_set_header Accept-Encoding "";
        proxy_cache_key $host$request_uri;
        add_header X-Ps02-Context-Cache $upstream_cache_status always;
    }
}
