{
  "name": "@inji-playground/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts of the playground: role interfaces, run events, interoperability reports, as TypeScript types and zod schemas.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --project protocol"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
